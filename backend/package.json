{
  "name": "vetsync-backend",
  "version": "1.0.0",
  "description": "VetSync — API de gestión de citas y telemedicina veterinaria (monolito modular, TDD, SOLID)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.8"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test-coverage-exclude=\"src/main.ts\" --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=70 \"test/**/*.test.ts\""
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
